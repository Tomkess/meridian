# Python
__pycache__/
*.pyc
*.pyo
.venv/
dist/
*.egg-info/

# Env
.env
.env.local

# Local config overrides
.meridian.local.toml

# macOS
.DS_Store

# Claude local
CLAUDE.local.md
.claude/settings.local.json
.claude/worktrees/

# Golden-set fixture — .claude/commands/meridian is provisioned at runtime by
# scripts/run_golden.sh (the fixture's .meridian.toml is tracked, not generated).
tests/golden/project/.claude/
tests/golden/runs/*.err

# Transient build artifacts (setuptools/uv)
build/

# Generated, not authored. Every row in the registry is derived from files that
# ARE tracked (specs/*/spec.md frontmatter, specs/goals/, specs/decisions/), so
# committing it protects nothing and conflicts on nearly every merge — and
# hand-resolving those conflicts has silently dropped rows. Regenerated by any
# command that mutates specs, or explicitly with `meridian index`.
# Anchored to the repo root: the shipped template and the golden fixture's own
# registry are unaffected.
/specs/REGISTRY.md
